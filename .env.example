# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID of your bot, from the same Developer Portal page
CLIENT_ID=your-application-id-here

# Optional: set this to a guild (server) ID while developing.
# Guild-scoped slash commands update instantly. If left blank,
# commands are registered globally (can take up to ~1 hour to appear).
GUILD_ID=
